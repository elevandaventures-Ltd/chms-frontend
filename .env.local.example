# Copy this file to .env.local before adding environment values.

NEXT_PUBLIC_APP_NAME=Elevanda Ventures
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Supabase ────────────────────────────────────────────────────────────────
# Required for authentication (middleware, session persistence, magic links).
# Find these values in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Also add the Site URL in Supabase dashboard:
#   Authentication → URL Configuration → Site URL = http://localhost:3000
# And set the redirect URL for magic links / OAuth:
#   Authentication → URL Configuration → Redirect URLs = http://localhost:3000/auth/callback
