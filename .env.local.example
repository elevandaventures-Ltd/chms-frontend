# Copy this file to .env.local before adding environment values.

NEXT_PUBLIC_APP_NAME=Elevanda Ventures
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── Supabase ────────────────────────────────────────────────────────────────
# Required for authentication (middleware, session persistence, magic links).
# Find these values in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Also add the Site URL in Supabase dashboard:
#   Authentication → URL Configuration → Site URL = http://localhost:3000
# And set the redirect URL for magic links / OAuth:
#   Authentication → URL Configuration → Redirect URLs = http://localhost:3000/auth/callback

# ── Meilisearch ──────────────────────────────────────────────────────────────
# Required for instant fuzzy search in the Member Directory (Day 13).
# Run Meilisearch locally: docker run -p 7700:7700 getmeili/meilisearch
# Or use Meilisearch Cloud: https://cloud.meilisearch.com
#
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=your-master-key-here
#
# Index setup — run once after Meilisearch is running:
#   curl -X POST 'http://localhost:7700/indexes' \
#     -H 'Authorization: Bearer your-master-key-here' \
#     -H 'Content-Type: application/json' \
#     -d '{"uid": "members", "primaryKey": "id"}'

# ── Twilio (Day 17) ───────────────────────────────────────────────────────────
# Required for welcome SMS on new member creation.
# Sign up at https://www.twilio.com and grab a trial phone number.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token-here
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
