# Copy this file to .env.local before adding environment values.

NEXT_PUBLIC_APP_NAME=Elevanda Ventures
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The frontend's own Next.js API routes (legacy / mock-backed).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ── chms-backend (Fastify API) ────────────────────────────────────────────────
# Base URL of the standalone backend service the typed client (src/lib/api)
# talks to. The backend authenticates with the Supabase access token below.
# Run it from the chms-backend repo: `npm run dev:api` (defaults to port 3001).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# ── Supabase ────────────────────────────────────────────────────────────────
# Required for authentication (middleware, session persistence, magic links).
# Find these values in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Also add the Site URL in Supabase dashboard:
#   Authentication → URL Configuration → Site URL = http://localhost:3000
# And set the redirect URL for magic links / OAuth:
#   Authentication → URL Configuration → Redirect URLs = http://localhost:3000/auth/callback

# ── Meilisearch ──────────────────────────────────────────────────────────────
# Required for instant fuzzy search in the Member Directory (Day 13).
# Run Meilisearch locally: docker run -p 7700:7700 getmeili/meilisearch
# Or use Meilisearch Cloud: https://cloud.meilisearch.com
#
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_KEY=your-master-key-here
#
# Index setup — run once after Meilisearch is running:
#   curl -X POST 'http://localhost:7700/indexes' \
#     -H 'Authorization: Bearer your-master-key-here' \
#     -H 'Content-Type: application/json' \
#     -d '{"uid": "members", "primaryKey": "id"}'

# ── Twilio (Day 17) ───────────────────────────────────────────────────────────
# Required for welcome SMS on new member creation.
# Sign up at https://www.twilio.com and grab a trial phone number.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token-here
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── Supabase service role (Day 40) ────────────────────────────────────────────
# Server-only key used by /api/unsubscribe to look up a member's notification
# prefs by capability token, bypassing RLS. Never expose this to the browser —
# it is only ever read in a route handler. Settings → API → service_role.
#
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Web Push / VAPID (Day 38) ─────────────────────────────────────────────────
# Optional. Without these, push permission + local test notifications still
# work; a VAPID key pair additionally lets the service worker subscribe to
# real server-triggered push. Generate with: npx web-push generate-vapid-keys
#
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=<public-key>
# VAPID_PRIVATE_KEY=<private-key>

# ── Resend (Day 39) ────────────────────────────────────────────────────────────
# Optional. Without it, the bulletin "Send Now" mock-sends (logs the render
# and returns success) instead of emailing a real test address.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
